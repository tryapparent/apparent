  "type": "module",
  "exports": {
    "./practice": {
      "types": "./dist/practice/policy.d.ts",
      "import": "./dist/practice/policy.js"
    },
    "./practice-host": {
      "types": "./dist/practice/host.d.ts",
      "import": "./dist/practice/host.js"
    },
    "./presentation": {
      "types": "./dist/host/presentation.d.ts",
      "import": "./dist/host/presentation.js"
    },
    "./selection": {
      "types": "./dist/host/selection.d.ts",
      "import": "./dist/host/selection.js"
    },
    "./wispr": {
      "types": "./dist/host/wispr.d.ts",
      "import": "./dist/host/wispr.js"
    },
    "./wispr-native": {
      "types": "./dist/host/wispr-native.d.ts",
      "import": "./dist/host/wispr-native.js"
    },
    "./projection": {
      "types": "./dist/host/projection.d.ts",
      "import": "./dist/host/projection.js"
    },
    "./actions": {
      "types": "./dist/host/actions.d.ts",
