{
  "name": "apparent-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "python3 ../../shared/ui/scripts/check-theme.py --owner public && tsc -b && vite build && vite build --config brand/vite.config.ts && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node ../enablement/site-build/prerender.ts",
    "preview": "vite preview",
    "test:video": "node --test ../enablement/browser-proof/test-video-demo.ts",
    "test:try-button": "node ../enablement/pages/test-try-button-browser.ts",
    "test:hosted": "node ../enablement/browser-proof/test-hosted-browser.mjs",
    "generate:tutorial": "node ../enablement/site-build/tutorial/render.ts",
    "test:tutorial": "node --test ../enablement/site-build/tutorial/render.test.ts",
    "generate:og-video": "node ../enablement/og-video/capture.mjs",
    "verify": "node ../enablement/site-build/verify.mjs",
    "build:pages-worker": "esbuild lib/pages-worker.ts --bundle --platform=browser --format=esm --outfile=dist-apparent/_worker.js"
  }
}
