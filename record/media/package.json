{
  "name": "@apparent/record-media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc && node --experimental-strip-types ../enablement/ci/bend/build.ts dist media",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/policy.test.ts test/frames.test.ts test/phone.test.ts test/screen.test.ts test/assembly.test.ts test/transcript/policy.test.ts test/selection/cues.test.ts test/selection/scene.test.ts test/export/quiet.test.ts",
    "test:native": "node --experimental-strip-types --test test/native.test.ts test/stage.test.ts"
  },
  "dependencies": {
    "@apparent/engine-sdk": "https://github.com/tryapparent/apparent/releases/download/engine-media-26c26ef3145493411f148ddc6897d9a701cb001d/apparent-engine-sdk-0.4.0.tgz"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
