{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react/*": ["./node_modules/@types/react/*"],
      "@apparent/ui/keycap": [
        "./node_modules/@apparent/ui/src/keyboard/keycap.tsx"
      ],
      "@apparent/ui/icons": ["./node_modules/@apparent/ui/src/icons.ts"],
      "@apparent/ui/button": ["./node_modules/@apparent/ui/src/button.tsx"],
      "@apparent/ui/input": ["./node_modules/@apparent/ui/src/forms/input.tsx"],
      "@apparent/ui/status-card": [
        "./node_modules/@apparent/ui/src/status-card.tsx"
      ],
      "@apparent/ui/disclosure-menu": [
        "./node_modules/@apparent/ui/src/disclosure-menu.tsx"
      ],
      "@apparent/ui/switch": [
        "./node_modules/@apparent/ui/src/forms/switch.tsx"
      ],
      "@apparent/ui/tooltip": [
        "./node_modules/@apparent/ui/src/forms/tooltip.tsx"
      ],
      "@apparent/ui/error-dialog": [
        "./node_modules/@apparent/ui/src/forms/error-dialog.tsx"
      ],
      "@apparent/ui/native-select": [
        "./node_modules/@apparent/ui/src/forms/native-select.tsx"
      ],
      "lucide-react": ["./node_modules/lucide-react"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "electron/reporting/index.ts",
    "../../../../composition/settings/renderer",
    "../../../../composition/pill/renderer",
    "../../../../composition/quit/view.tsx"
  ]
}
