--- /dev/null
+++ b/src/shared/CleanFrontend.hpp
@@ -0,0 +1,57 @@
+#pragma once
+#include <systemd/sd-bus.h>
+#include <poll.h>
+#include <unistd.h>
+#include <string>
+#include <string_view>
+#include <memory>
+
+// A frontend-owned D-Bus connection/lifetime, not a caller session-path string.
+class CCleanFrontend {
+    int pidfd = -1;
+    std::string unique;
+    mutable bool terminal = false;
+    sd_bus* bus = nullptr;
+    sd_bus_slot* watch = nullptr;
+    CCleanFrontend(int fd, std::string name) : pidfd(fd), unique(std::move(name)) {}
+  public:
+    ~CCleanFrontend() { sd_bus_slot_unref(watch); sd_bus_unref(bus); if (pidfd >= 0) close(pidfd); }
+    static std::shared_ptr<CCleanFrontend> admit(const std::string& sender) {
+        sd_bus* bus = nullptr; sd_bus_creds* creds = nullptr;
+        const char* owner = nullptr; int fd = -1;
+        bool ok = sd_bus_open_user(&bus) >= 0 &&
+            sd_bus_get_name_creds(bus, "org.freedesktop.portal.Desktop", SD_BUS_CREDS_UNIQUE_NAME | SD_BUS_CREDS_PIDFD, &creds) >= 0 &&
+            sd_bus_creds_get_unique_name(creds, &owner) >= 0 && owner && sender == owner &&
+            sd_bus_creds_get_pidfd_dup(creds, &fd) >= 0;
+        sd_bus_creds_unref(creds);
+        if (!ok) { sd_bus_unref(bus); if (fd >= 0) close(fd); return {}; }
+        auto result = std::shared_ptr<CCleanFrontend>(new CCleanFrontend(fd, sender));
+        result->bus = bus;
+        if (sd_bus_match_signal(bus, &result->watch, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                "org.freedesktop.DBus", "NameOwnerChanged",
+                [](sd_bus_message* message, void* data, sd_bus_error*) -> int {
+                    auto self = static_cast<CCleanFrontend*>(data);
+                    const char *name = nullptr, *old = nullptr, *now = nullptr;
+                    if (sd_bus_message_read(message, "sss", &name, &old, &now) < 0) { self->terminal = true; return 0; }
+                    if (std::string_view(name) == "org.freedesktop.portal.Desktop" && self->unique == old && std::string_view(old) != now)
+                        self->terminal = true;
+                    return 0;
+                }, result.get()) < 0) return {};
+        return result->live() ? result : nullptr;
+    }
+    bool sender(const std::string& s) const { return s == unique && live(); }
+    bool live() const {
+        pollfd p{pidfd, POLLIN, 0};
+        if (terminal || pidfd < 0 || poll(&p, 1, 0) != 0) { terminal = true; return false; }
+        int processed;
+        while ((processed = sd_bus_process(bus, nullptr)) > 0) {}
+        if (processed < 0 || terminal) { terminal = true; return false; }
+        sd_bus_creds* creds = nullptr;
+        const char* owner = nullptr;
+        bool ok = sd_bus_get_name_creds(bus, "org.freedesktop.portal.Desktop", SD_BUS_CREDS_UNIQUE_NAME, &creds) >= 0 &&
+            sd_bus_creds_get_unique_name(creds, &owner) >= 0 && owner && unique == owner && !terminal;
+        sd_bus_creds_unref(creds);
+        if (!ok) terminal = true;
+        return ok;
+    }
+};
