+++ b/src/shared/CleanStream.hpp
@@ -0,0 +1,90 @@
+#pragma once
+#include "apparent-clean-v1-client.h"
+#include "apparent-clean-receipt.h"
+#include "apparent-clean-receipt-validate.h"
+#include "CleanFrontend.hpp"
+#include <cstring>
+#include <fcntl.h>
+#include <limits>
+#include <optional>
+#include <sys/stat.h>
+#include <wayland-client.h>
+
+// Uses the backend's existing native connection and actual screencopy objects.
+// No private screenshot endpoint and no source selector outside portal Start.
+class CCleanStream {
+    wl_display* display = nullptr;
+    wl_registry* registry = nullptr;
+    apparent_clean_manager_v1* manager = nullptr;
+    apparent_clean_grant_v1* grant = nullptr;
+    apparent_clean_sample_v1* sample = nullptr;
+    std::shared_ptr<CCleanFrontend> frontend;
+    uint32_t portal = 0, sequence = 0, generation = 0, frameID = 0, bufferID = 0;
+    bool failed = false;
+    std::optional<apparent_clean_receipt_v1> received;
+  public:
+    explicit CCleanStream(wl_display* display, std::shared_ptr<CCleanFrontend> f) : display(display), frontend(std::move(f)) {
+        registry = wl_display_get_registry(display);
+        static const wl_registry_listener listener{
+            [](void* data, wl_registry* registry, uint32_t name, const char* iface, uint32_t) {
+                auto self = static_cast<CCleanStream*>(data);
+                if (!strcmp(iface, "apparent_clean_manager_v1"))
+                    self->manager = static_cast<apparent_clean_manager_v1*>(wl_registry_bind(registry, name, &apparent_clean_manager_v1_interface, 1));
+            }, [](void*, wl_registry*, uint32_t) {}};
+        wl_registry_add_listener(registry, &listener, this);
+        if (wl_display_roundtrip(display) < 0 || !manager) failed = true;
+    }
+    ~CCleanStream() {
+        cancelSample();
+        if (grant) apparent_clean_grant_v1_destroy(grant);
+        if (manager) apparent_clean_manager_v1_destroy(manager);
+        if (registry) wl_registry_destroy(registry);
+    }
+    bool authorize(wl_display* display, int fd, wl_proxy* output, int x, int y, int w, int h, bool cursor) {
+        if (!live() || grant || !object(output, "wl_output")) return false;
+        // libwayland represents every generated opaque interface by wl_proxy.
+        // Check its runtime interface AND connection before the C ABI view.
+        grant = apparent_clean_manager_v1_authorize(manager, fd, reinterpret_cast<wl_output*>(output), x,y,w,h,cursor);
+        static const apparent_clean_grant_v1_listener listener{
+            [](void* data, apparent_clean_grant_v1*, uint32_t serial) { static_cast<CCleanStream*>(data)->portal = serial; },
+            [](void* data, apparent_clean_grant_v1*) { static_cast<CCleanStream*>(data)->failed = true; }};
+        apparent_clean_grant_v1_add_listener(grant, &listener, this);
+        if (wl_display_roundtrip(display) < 0) failed = true;
+        return live() && portal;
+    }
+    bool live() const { return !failed && frontend && frontend->live(); }
+    bool object(wl_proxy* proxy, const char* iface) const {
+        return proxy && wl_proxy_get_display(proxy) == display && !strcmp(wl_proxy_get_class(proxy), iface);
+    }
+    void cancelSample() {
+        received.reset();
+        if (sample) { apparent_clean_sample_v1_destroy(sample); sample = nullptr; }
+    }
+    bool attach(wl_proxy* frame, wl_proxy* buffer, uint32_t bufferGeneration) {
+        cancelSample();
+        if (!live() || !portal || !grant || sequence == UINT32_MAX || !bufferGeneration ||
+            !object(frame, "zwlr_screencopy_frame_v1") || !object(buffer, "wl_buffer")) { failed = true; return false; }
+        frameID = wl_proxy_get_id(frame);
+        bufferID = wl_proxy_get_id(buffer);
+        generation = bufferGeneration;
+        sample = apparent_clean_grant_v1_attach(grant, reinterpret_cast<zwlr_screencopy_frame_v1*>(frame), ++sequence, generation);
+        static const apparent_clean_sample_v1_listener listener{
+            [](void* data, apparent_clean_sample_v1*, int fd) {
+                auto self = static_cast<CCleanStream*>(data);
+                apparent_clean_receipt_v1 r{};
+                const bool ok = self->live() && !self->received && apparent_clean_read_receipt_v1(fd,
+                    self->portal, self->sequence, self->generation, self->frameID, self->bufferID, &r);
+                close(fd);
+                if (ok) self->received = r; else self->failed = true;
+            }, [](void* data, apparent_clean_sample_v1*) { static_cast<CCleanStream*>(data)->failed = true; }};
+        apparent_clean_sample_v1_add_listener(sample, &listener, this);
+        return true;
+    }
+    bool publish(wl_proxy* buffer, uint32_t bufferGeneration, apparent_clean_receipt_v1* meta) {
+        if (!live() || !received || !meta || bufferGeneration != generation ||
+            !object(buffer, "wl_buffer") || wl_proxy_get_id(buffer) != bufferID) return false;
+        *meta = *received;
+        cancelSample(); // a dequeued buffer can receive this sample exactly once
+        return true;
+    }
+};
