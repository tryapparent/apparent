--- /dev/null
+++ b/src/clean-role-fd.h
@@ -0,0 +1,60 @@
+/* Private SelectSources extension. Carries a descriptor, not permission. */
+#pragma once
+#include <gio/gio.h>
+#include <gio/gunixfdlist.h>
+#include <unistd.h>
+
+#define XDP_CLEAN_ROLE_KEY "apparent_clean_role"
+
+static gboolean
+xdp_clean_role_forward (GDBusMessage *message,
+                        GVariant *options,
+                        GVariantBuilder *filtered,
+                        GUnixFDList **out_fds,
+                        GError **error)
+{
+  GVariantIter iter;
+  const char *key;
+  GVariant *value;
+  g_autoptr(GVariant) role = NULL;
+  g_autoptr(GUnixFDList) compact = NULL;
+  GUnixFDList *incoming;
+  int fd, index;
+
+  g_variant_iter_init (&iter, options);
+  while (g_variant_iter_next (&iter, "{&sv}", &key, &value))
+    {
+      if (g_str_equal (key, XDP_CLEAN_ROLE_KEY))
+        {
+          if (role || !g_variant_is_of_type (value, G_VARIANT_TYPE_HANDLE))
+            {
+              g_variant_unref (value);
+              g_set_error_literal (error, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
+                                   "Clean role must be one Unix FD handle");
+              return FALSE;
+            }
+          role = g_variant_ref (value);
+        }
+      g_variant_unref (value);
+    }
+  if (!role)
+    return TRUE;
+  incoming = g_dbus_message_get_unix_fd_list (message);
+  if (!incoming)
+    {
+      g_set_error_literal (error, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
+                           "Clean role FD list missing");
+      return FALSE;
+    }
+  fd = g_unix_fd_list_get (incoming, g_variant_get_handle (role), error);
+  if (fd < 0)
+    return FALSE;
+  compact = g_unix_fd_list_new ();
+  index = g_unix_fd_list_append (compact, fd, error);
+  close (fd);
+  if (index < 0)
+    return FALSE;
+  g_variant_builder_add (filtered, "{sv}", XDP_CLEAN_ROLE_KEY, g_variant_new_handle (index));
+  *out_fds = g_steal_pointer (&compact);
+  return TRUE;
+}
