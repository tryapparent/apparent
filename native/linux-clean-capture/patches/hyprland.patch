+#include "ApparentClean.hpp"
+#include "Screencopy.hpp"
+#include "core/Output.hpp"
+#include "../Compositor.hpp"
+#include "../desktop/state/WindowState.hpp"
+#include "../desktop/view/Window.hpp"
