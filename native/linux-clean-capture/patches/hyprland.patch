+using namespace Screenshare;
+namespace {
+struct Sample {
+    wl_resource* resource = nullptr;
+    SP<CCleanFrameContext> context;
+};
+void sampleDestroy(wl_resource* r) {
+    auto p = static_cast<std::shared_ptr<Sample>*>(wl_resource_get_user_data(r));
+    (*p)->resource = nullptr;
+    if ((*p)->context) (*p)->context->revoke();
+    delete p;
+}
+}
+
+void CApparentCleanProtocol::destroy(wl_client*, wl_resource* r) { wl_resource_destroy(r); }
+CApparentCleanProtocol::CApparentCleanProtocol() {
+    global = wl_global_create(g_pCompositor->m_wlDisplay, &apparent_clean_manager_v1_interface, 1, this, bind);
+}
+CApparentCleanProtocol::~CApparentCleanProtocol() {
+    // Clear user data before releasing owners; resources can outlive globals.
+    for (auto& g : grants) { g->binding->revoke(); if (g->resource) wl_resource_set_user_data(g->resource, nullptr); }
+    for (auto& r : roles) { r->role->revoke(); if (r->resource) wl_resource_set_user_data(r->resource, nullptr); }
+    if (global) wl_global_destroy(global);
+}
+void CApparentCleanProtocol::bind(wl_client* c, void* data, uint32_t, uint32_t id) {
+    static const struct apparent_clean_manager_v1_interface impl{destroy, registerSurface, authorize};
+    auto r = wl_resource_create(c, &apparent_clean_manager_v1_interface, 1, id);
+    if (!r) { wl_client_post_no_memory(c); return; }
+    wl_resource_set_implementation(r, &impl, data, nullptr);
+}
+void CApparentCleanProtocol::registerSurface(wl_client* c, wl_resource* manager, uint32_t id, wl_resource* surface) {
+    auto self = static_cast<CApparentCleanProtocol*>(wl_resource_get_user_data(manager));
+    static const struct apparent_clean_role_v1_interface impl{destroy};
+    auto r = wl_resource_create(c, &apparent_clean_role_v1_interface, 1, id);
+    if (!r) { wl_client_post_no_memory(c); return; }
+    wl_resource_set_implementation(r, &impl, nullptr, [](wl_resource* r) {
+        auto role = static_cast<Role*>(wl_resource_get_user_data(r));
+        if (role) { role->role->revoke(); role->resource = nullptr; }
+    });
+    auto s = CWLSurfaceResource::fromResource(surface);
+    auto peer = Apparent::Clean::Peer::pin(c);
+    PHLWINDOW window;
+    if (self && peer && peer->live() && s && s->client() == c && s->m_mapped) {
+        for (const auto& w : Desktop::windowState()->windows())
+            if (!w->m_isX11 && w->m_isMapped && w->resource() == s) { window = w; break; }
+    }
+    bool duplicate = false;
+    if (self) for (const auto& existing : self->roles)
+        if (existing->role->live() && existing->role->window() == window) duplicate = true;
+    if (!window || duplicate || self->serial == UINT32_MAX) { apparent_clean_role_v1_send_failed(r); return; }
+    auto role = SP<CCleanRole>(new CCleanRole(window, s, Apparent::Clean::RoleCapability::mintInternal(), peer));
+    auto entry = std::make_unique<Role>(Role{r, role, ++self->serial});
+    wl_resource_set_user_data(r, entry.get());
+    self->roles.emplace_back(std::move(entry));
+    int fd = role->capability()->exportFD();
+    if (fd < 0) { role->revoke(); apparent_clean_role_v1_send_failed(r); return; }
+    apparent_clean_role_v1_send_capability(r, fd); close(fd);
+}
+void CApparentCleanProtocol::authorize(wl_client* c, wl_resource* manager, uint32_t id, int32_t fd, wl_resource* output,
+                                      int32_t x, int32_t y, int32_t w, int32_t h, uint32_t cursor) {
+    auto self = static_cast<CApparentCleanProtocol*>(wl_resource_get_user_data(manager));
+    static const struct apparent_clean_grant_v1_interface impl{destroy, attach};
+    auto r = wl_resource_create(c, &apparent_clean_grant_v1_interface, 1, id);
+    if (!r) { close(fd); wl_client_post_no_memory(c); return; }
+    wl_resource_set_implementation(r, &impl, nullptr, [](wl_resource* r) {
+        auto grant = static_cast<Grant*>(wl_resource_get_user_data(r));
+        if (grant) { grant->binding->revoke(); grant->resource = nullptr; }
+    });
+    auto peer = Apparent::Clean::Peer::pin(c);
+    auto o = CWLOutputResource::fromResource(output);
+    Role* role = nullptr;
+    if (self) for (const auto& candidate : self->roles)
+        if (candidate->role->live() && candidate->role->capability()->matches(fd)) { role = candidate.get(); break; }
+    close(fd);
+    // Only the currently registered, pidfd-pinned portal backend may turn a
+    // surface identifier into capture policy. Ordinary clients cannot mint it.
+    if (!self || !peer || !peer->ownsBackendName() || !role || !o || !o->m_monitor || cursor > 1 ||
+        x < 0 || y < 0 || w < 0 || h < 0 || ((w == 0) != (h == 0)) || (!w && (x || y)) || self->serial == UINT32_MAX ||
+        o->m_monitor->m_scale != 1.0 || o->m_monitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL) {
+        apparent_clean_grant_v1_send_failed(r); return;
+    }
+    const auto generation = ++self->serial;
+    auto binding = SP<CCleanPortalBinding>(new CCleanPortalBinding(r, generation, peer));
+    auto grant = std::make_unique<Grant>(Grant{r, binding, role->role, o->m_monitor, CBox{x,y,w,h}, !!cursor, role->serial});
+    grant->disconnect = o->m_monitor->m_events.disconnect.listen([binding] { binding->revoke(); });
+    grant->mode = o->m_monitor->m_events.modeChanged.listen([binding] { binding->revoke(); });
+    grant->dpms = o->m_monitor->m_events.dpmsChanged.listen([binding] { binding->revoke(); });
+    wl_resource_set_user_data(r, grant.get());
+    self->grants.emplace_back(std::move(grant));
+    apparent_clean_grant_v1_send_authorized(r, generation);
+}
+void CApparentCleanProtocol::attach(wl_client* c, wl_resource* r, uint32_t id, wl_resource* frame, uint32_t seq, uint32_t bufferGeneration) {
+    static const struct apparent_clean_sample_v1_interface impl{destroy};
+    auto sample = std::make_shared<Sample>();
+    sample->resource = wl_resource_create(c, &apparent_clean_sample_v1_interface, 1, id);
+    if (!sample->resource) { wl_client_post_no_memory(c); return; }
+    wl_resource_set_implementation(sample->resource, &impl, new std::shared_ptr<Sample>(sample), sampleDestroy);
+    auto grant = static_cast<Grant*>(wl_resource_get_user_data(r));
+    if (!grant || !grant->monitor || !grant->binding->live(c) || !grant->role->live() || !seq || !bufferGeneration) {
+        apparent_clean_sample_v1_send_failed(sample->resource); return;
+    }
+    const auto roleSerial = grant->roleSerial;
+    const auto surfaceID = grant->role->window()->resource()->id();
+    const auto frameID = wl_resource_get_id(frame);
+    const auto logical = grant->region;
+    sample->context = PROTO::screencopy->bindCleanFrame(c, frame, grant->binding, grant->role, grant->monitor.lock(),
+        logical, grant->cursor, seq, bufferGeneration, [sample, roleSerial, surfaceID, frameID, logical]() {
+            if (!sample->resource || !sample->context || !sample->context->receipt()) return false;
+            const auto& r = *sample->context->receipt();
+            // Native completion has revalidated permission/source/role/buffer.
+            // Sealed receipt is sent on this exact sample before frame.ready.
+            apparent_clean_receipt_v1 wire{};
+            wire.magic = APPARENT_CLEAN_MAGIC; wire.version = 1; wire.size = sizeof(wire);
+            wire.portal = r.identity.portalGeneration; wire.sequence = r.identity.sequence;
+            wire.source_generation = r.identity.sourceGeneration; wire.buffer_generation = r.identity.bufferGeneration;
+            wire.frame_id = frameID; wire.buffer_id = sample->context->bufferResourceID();
+            wire.role_serial = roleSerial; wire.surface_id = surfaceID;
+            wire.x = logical.x; wire.y = logical.y;
+            wire.width = logical.w ? logical.w : r.outputPixels.x;
+            wire.height = logical.h ? logical.h : r.outputPixels.y;
+            wire.output_width = r.outputPixels.x; wire.output_height = r.outputPixels.y;
+            wire.transform = r.transform; wire.cursor = r.overlayCursor; wire.scale = r.scale;
+            int fd = memfd_create("apparent-clean-sample", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+            if (fd < 0) return false;
+            bool ok = write(fd, &wire, sizeof(wire)) == sizeof(wire) &&
+                fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) == 0;
+            if (ok) apparent_clean_sample_v1_send_receipt(sample->resource, fd);
+            close(fd); return ok;
+        });
+    if (!sample->context) apparent_clean_sample_v1_send_failed(sample->resource);
+}
