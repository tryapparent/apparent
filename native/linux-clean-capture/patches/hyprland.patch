+SP<CCleanFrameContext> CScreencopyProtocol::bindCleanFrame(wl_client* requester, wl_resource* resource,
+        SP<CCleanPortalBinding> portal, SP<CCleanRole> role, PHLMONITOR monitor, CBox region, bool cursor,
+        uint64_t sequence, uint64_t generation, std::function<bool()> publish) {
+    for (const auto& f : m_frames) {
+        if (f->m_resource->resource() != resource || f->m_resource->client() != requester) continue;
+        if (f->m_buffer || f->m_cleanPublish || !f->m_session || !f->m_frame) return {};
+        f->m_cleanPublish = [] { return false; }; // failed attachment never becomes ordinary success
+        auto s = f->m_session;
