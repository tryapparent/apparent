+++ b/src/managers/screenshare/CleanLease.hpp
@@ -0,0 +1,101 @@
+#pragma once
+// Internal compositor adapter state; not a capture permission or public IPC API.
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <vector>
+
+namespace Apparent::Clean {
+class RoleCapability {
+    int retained = -1;
+    int peer = -1;
+    bool revoked = false;
+    explicit RoleCapability(int r, int w) : retained(r), peer(w) {}
+  public:
+    RoleCapability(const RoleCapability&) = delete;
+    ~RoleCapability() { if (retained >= 0) close(retained); if (peer >= 0) close(peer); }
+    static std::shared_ptr<RoleCapability> mintInternal() {
+        int fd[2];
+        if (pipe2(fd, O_CLOEXEC | O_NONBLOCK) != 0) throw std::runtime_error("role capability pipe2 failed");
+        return std::shared_ptr<RoleCapability>(new RoleCapability(fd[0], fd[1]));
+    }
+    int exportFD() const { return revoked ? -1 : fcntl(retained, F_DUPFD_CLOEXEC, 0); }
+    bool matches(int incoming) const {
+        struct stat a{}, b{};
+        const int flags = fcntl(incoming, F_GETFL);
+        return !revoked && flags >= 0 && (flags & O_ACCMODE) == O_RDONLY &&
+            fstat(retained, &a) == 0 && fstat(incoming, &b) == 0 && S_ISFIFO(b.st_mode) &&
+            a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+    }
+    void revoke() { revoked = true; }
+    bool live() const { return !revoked; }
+};
+
+class CapabilityRegistry {
+    std::vector<std::weak_ptr<RoleCapability>> entries;
+  public:
+    std::shared_ptr<RoleCapability> mintInternal() {
+        auto cap = RoleCapability::mintInternal(); entries.emplace_back(cap); return cap;
+    }
+    std::shared_ptr<RoleCapability> importFD(int fd) {
+        for (auto it = entries.begin(); it != entries.end();) {
+            auto cap = it->lock();
+            if (!cap) { it = entries.erase(it); continue; }
+            if (cap->matches(fd)) return cap;
+            ++it;
+        }
+        return {};
+    }
+};
+
+// This is NOT the deduplicated CScreenshareSession. One instance belongs to one
+// independently authorized backend SSession resource. EOF/Close must revoke it.
+class PortalLifetime {
+    bool active = true;
+    uint64_t next = 1;
+  public:
+    const uint64_t generation;
+    explicit PortalLifetime(uint64_t g) : generation(g) { if (!g) active = false; }
+    ~PortalLifetime() { revoke(); }
+    void revoke() { active = false; }
+    bool live() const { return active; }
+    bool claim(uint64_t sequence) {
+        if (!active || !sequence || sequence != next || next == std::numeric_limits<uint64_t>::max()) return false;
+        ++next; return true;
+    }
+};
+
+// Copied by value only at native completion. No PTS participates in identity.
+struct Receipt {
+    uint64_t portalGeneration, sequence, sourceGeneration, bufferGeneration;
+    uintptr_t nativeFrame, nativeBuffer;
+    bool operator==(const Receipt&) const = default;
+};
+
+class FrameLease {
+    std::weak_ptr<PortalLifetime> portal;
+    std::weak_ptr<RoleCapability> role;
+    Receipt identity;
+    bool claimed = false, terminal = false;
+  public:
+    FrameLease(std::shared_ptr<PortalLifetime> p, std::shared_ptr<RoleCapability> r, Receipt i) : portal(p), role(r), identity(i) {
+        claimed = p && r && p->generation == i.portalGeneration && p->claim(i.sequence) && r->live() &&
+            i.sourceGeneration && i.bufferGeneration && i.nativeFrame && i.nativeBuffer;
+    }
+    bool live(uint64_t source, uintptr_t frame, uintptr_t buffer, uint64_t bufferGeneration) const {
+        auto p = portal.lock(); auto r = role.lock();
+        return claimed && !terminal && p && p->live() && r && r->live() && source == identity.sourceGeneration &&
+            frame == identity.nativeFrame && buffer == identity.nativeBuffer && bufferGeneration == identity.bufferGeneration;
+    }
+    std::optional<Receipt> complete(uint64_t source, uintptr_t frame, uintptr_t buffer, uint64_t generation) {
+        if (!live(source, frame, buffer, generation)) { terminal = true; return {}; }
+        terminal = true; return identity;
+    }
+    void revoke() { terminal = true; }
+};
+}
