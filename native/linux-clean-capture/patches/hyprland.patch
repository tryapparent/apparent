+    }
+    bool live() const { pollfd p{fd, POLLIN, 0}; return fd >= 0 && poll(&p, 1, 0) == 0; }
+    bool ownsBackendName() const {
+        if (backendRevoked || !live()) { backendRevoked = true; return false; }
+        if (!backendBus) {
+            if (sd_bus_open_user(&backendBus) < 0 || sd_bus_match_signal(backendBus, &backendWatch,
+                    "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameOwnerChanged",
+                    [](sd_bus_message* message, void* data, sd_bus_error*) -> int {
+                        auto self = static_cast<const Peer*>(data);
+                        const char *name = nullptr, *old = nullptr, *now = nullptr;
+                        if (sd_bus_message_read(message, "sss", &name, &old, &now) < 0) { self->backendRevoked = true; return 0; }
+                        if (std::string_view(name) == "org.freedesktop.impl.portal.desktop.hyprland" &&
+                            !self->backendOwner.empty() && self->backendOwner == old && std::string_view(old) != now)
+                            self->backendRevoked = true;
+                        return 0;
+                    }, const_cast<Peer*>(this)) < 0) { backendRevoked = true; return false; }
+        }
+        int processed;
+        while ((processed = sd_bus_process(backendBus, nullptr)) > 0) {}
+        if (processed < 0 || backendRevoked) { backendRevoked = true; return false; }
+        sd_bus_creds *owner = nullptr, *peer = nullptr;
+        bool ok = false; pid_t a = 0, b = 0; int ownerfd = -1; const char* unique = nullptr;
+        if (sd_bus_get_name_creds(backendBus, "org.freedesktop.impl.portal.desktop.hyprland", SD_BUS_CREDS_PID | SD_BUS_CREDS_PIDFD | SD_BUS_CREDS_UNIQUE_NAME, &owner) >= 0 &&
+            sd_bus_creds_get_unique_name(owner, &unique) >= 0 && unique &&
+            sd_bus_creds_get_pidfd_dup(owner, &ownerfd) >= 0 &&
+            sd_bus_creds_new_from_pidfd(&peer, fd, SD_BUS_CREDS_PID) >= 0 &&
+            sd_bus_creds_get_pid(owner, &a) >= 0 && sd_bus_creds_get_pid(peer, &b) >= 0) {
+            pollfd p{ownerfd, POLLIN, 0};
+            // Both process handles stay pinned and live across the equality
+            // test. Thus numeric reuse cannot supply process equivalence.
+            ok = !backendRevoked && a > 0 && a == b && live() && poll(&p, 1, 0) == 0 && (backendOwner.empty() || backendOwner == unique);
+            if (ok && backendOwner.empty()) backendOwner = unique;
+        }
+        if (ownerfd >= 0) close(ownerfd);
+        sd_bus_creds_unref(owner); sd_bus_creds_unref(peer);
+        if (!ok) backendRevoked = true;
+        return ok;
+    }
+};
+}
