+#include "CleanFrame.hpp"
+#include "../../Compositor.hpp"
+#include "../../state/MonitorState.hpp"
+#include "../SessionLockManager.hpp"
+#include "../permissions/DynamicPermissionManager.hpp"
+#include "../../desktop/view/Window.hpp"
+
+using namespace Screenshare;
+
+CCleanRole::CCleanRole(PHLWINDOW w, SP<CWLSurfaceResource> x, std::shared_ptr<Apparent::Clean::RoleCapability> cap, std::shared_ptr<Apparent::Clean::Peer> peer) :
+    m_window(w), m_surface(x), m_peer(std::move(peer)), m_cap(std::move(cap)) {
+    m_unmap = x->m_events.unmap.listen([this] { revoke(); });
+    m_destroy = x->m_events.destroy.listen([this] { revoke(); });
+    m_reassociate = w->m_events.destroy.listen([this] { revoke(); });
+}
+CCleanRole::~CCleanRole() { revoke(); }
+void CCleanRole::revoke() { if (m_cap) m_cap->revoke(); }
+bool CCleanRole::live() const {
+    auto w = m_window.lock(); auto x = m_surface.lock();
+    return m_peer && m_peer->live() && m_cap && m_cap->live() && w && x && w->m_isMapped && !w->m_isX11 &&
+        w->resource() == x && x->m_mapped && x->good();
+}
+
+CCleanPortalBinding::CCleanPortalBinding(wl_resource* r, uint64_t generation, std::shared_ptr<Apparent::Clean::Peer> peer) :
+    m_resource(r), m_owner(wl_resource_get_client(r)), m_lifetime(std::make_shared<Apparent::Clean::PortalLifetime>(generation)), m_peer(std::move(peer)) {
+    m_destroy.owner = this;
+    m_destroy.listener.notify = [](wl_listener* l, void*) {
+        auto d = reinterpret_cast<SDestroyListener*>(l);
+        d->owner->revoke();
+        d->owner->m_resource = nullptr;
+        wl_list_remove(&l->link); wl_list_init(&l->link);
+    };
+    wl_resource_add_destroy_listener(r, &m_destroy.listener);
+    m_permissions = g_pDynamicPermissionManager->m_cleanPolicyChanged.listen([this] { revoke(); });
+    m_lock = g_pSessionLockManager->m_events.lock.listen([this] { revoke(); });
+}
+CCleanPortalBinding::~CCleanPortalBinding() {
+    revoke(); wl_list_remove(&m_destroy.listener.link);
+}
+void CCleanPortalBinding::revoke() { m_lifetime->revoke(); }
+bool CCleanPortalBinding::live(wl_client* owner) const {
+    return m_resource && m_owner == owner && m_lifetime->live() && m_peer && m_peer->ownsBackendName();
+}
+
+CCleanFrameContext::CCleanFrameContext(SP<CCleanPortalBinding> portal, SP<CCleanRole> role, WP<CScreenshareSession> session,
+        CBox region, bool cursor, uint64_t sequence, uint64_t bufferGeneration, uintptr_t nativeFrame) :
+    m_portal(portal), m_role(role), m_session(session), m_monitor(session->monitor()), m_region(region),
+    m_outputPixels(session->monitor()->m_pixelSize), m_scale(session->monitor()->m_scale), m_transform(session->monitor()->m_transform),
+    m_cursor(cursor), m_sourceGeneration(session->sourceGeneration()), m_sequence(sequence), m_bufferGeneration(bufferGeneration), m_nativeFrame(nativeFrame) {
+    m_lock = g_pSessionLockManager->m_events.lock.listen([this] { revoke(); });
+    m_dpms = m_monitor->m_events.dpmsChanged.listen([this] { revoke(); });
+    m_constraints = session->m_events.constraintsChanged.listen([this] { revoke(); });
+    m_stopped = session->m_events.stopped.listen([this] { revoke(); });
+    m_permissions = g_pDynamicPermissionManager->m_cleanPolicyChanged.listen([this] { revoke(); });
+}
+
+bool CCleanFrameContext::bindBuffer(SP<IHLBuffer> buffer, wl_client* owner) {
+    if (m_buffer || !live(owner, m_region, m_cursor) || !buffer || !buffer->m_resource || !buffer->m_resource->good()) return false;
+    m_buffer = buffer;
+    const Apparent::Clean::Receipt identity{m_portal->lifetime()->generation, m_sequence, m_sourceGeneration,
+        m_bufferGeneration, m_nativeFrame, reinterpret_cast<uintptr_t>(buffer.get())};
+    m_lease = std::make_unique<Apparent::Clean::FrameLease>(m_portal->lifetime(), m_role->capability(), identity);
+    return m_lease->live(m_sourceGeneration, m_nativeFrame, reinterpret_cast<uintptr_t>(buffer.get()), m_bufferGeneration);
+}
+
+bool CCleanFrameContext::live(wl_client* owner, CBox region, bool cursor) const {
+    auto m = m_monitor.lock();
+    if (m_revoked || !m_portal || !m_portal->live(owner) || !m_role || !m_role->live() || !m_session || !m_session->isActive() || !m ||
+        m_session->monitor() != m || !State::monitorState()->contains(m) || m_session->sourceGeneration() != m_sourceGeneration ||
+        m_region != region || m_cursor != cursor || m_outputPixels != m->m_pixelSize || m_scale != m->m_scale || m_transform != m->m_transform ||
+        !m->m_output || !m->m_dpmsStatus || m->m_isBeingLeased || m->isMirror() ||
+        !g_pCompositor->m_sessionActive || !g_pCompositor->m_dpmsStateOn || g_pSessionLockManager->isSessionLocked()) return false;
+    if (g_pDynamicPermissionManager->clientPermissionMode(owner, PERMISSION_TYPE_SCREENCOPY) != PERMISSION_RULE_ALLOW_MODE_ALLOW || m_revoked) return false;
+    return !m_buffer || (m_buffer->m_resource && m_buffer->m_resource->good() && m_lease &&
+        m_lease->live(m_sourceGeneration, m_nativeFrame, reinterpret_cast<uintptr_t>(m_buffer.get()), m_bufferGeneration));
+}
+
+bool CCleanFrameContext::complete(wl_client* owner, CBox region, bool cursor) {
+    if (m_receipt || !m_buffer || !live(owner, region, cursor)) { revoke(); return false; }
+    const auto identity = m_lease->complete(m_sourceGeneration, m_nativeFrame, reinterpret_cast<uintptr_t>(m_buffer.get()), m_bufferGeneration);
+    if (!identity) { revoke(); return false; }
+    m_receipt = SCleanReceipt{*identity, m_monitor, m_role->window(), m_region, m_outputPixels, m_scale, m_transform, m_cursor};
+    return true;
+}
+void CCleanFrameContext::revoke() {
+    m_revoked = true;
+    if (m_lease) m_lease->revoke();
+    // A receipt already handed to a consumer must never be mutated/reminted.
+    // Protocol publication consumes the completed frame's immutable receipt.
+}
