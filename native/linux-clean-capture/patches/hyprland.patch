+        constexpr int peerPidfd = 77; // Linux SO_PEERPIDFD (6.5+)
+        if (!c || getsockopt(wl_client_get_fd(c), SOL_SOCKET, peerPidfd, &f, &n) || n != sizeof(f)) return {};
