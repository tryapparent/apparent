+#pragma once
+#include "WaylandProtocol.hpp"
+#include "../managers/screenshare/CleanFrame.hpp"
+#include <vector>
+
+class CApparentCleanProtocol {
+    struct Role { wl_resource* resource; SP<Screenshare::CCleanRole> role; uint32_t serial; };
+    struct Grant {
+        wl_resource* resource;
+        SP<Screenshare::CCleanPortalBinding> binding;
+        SP<Screenshare::CCleanRole> role;
+        PHLMONITORREF monitor;
+        CBox region;
+        bool cursor;
+        uint32_t roleSerial;
+        CHyprSignalListener disconnect, mode, dpms;
+    };
+    wl_global* global = nullptr;
+    std::vector<std::unique_ptr<Role>> roles;
+    std::vector<std::unique_ptr<Grant>> grants;
+    uint32_t serial = 0;
+    static void destroy(wl_client*, wl_resource*);
+    static void bind(wl_client*, void*, uint32_t, uint32_t);
+    static void registerSurface(wl_client*, wl_resource*, uint32_t, wl_resource*);
+    static void authorize(wl_client*, wl_resource*, uint32_t, int32_t, wl_resource*, int32_t, int32_t, int32_t, int32_t, uint32_t);
+    static void attach(wl_client*, wl_resource*, uint32_t, wl_resource*, uint32_t, uint32_t);
+  public:
+    CApparentCleanProtocol();
+    ~CApparentCleanProtocol();
+};
+namespace PROTO { inline UP<CApparentCleanProtocol> apparentClean; }
