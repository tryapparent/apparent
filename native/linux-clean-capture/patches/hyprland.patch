+#pragma once
+#include "apparent-clean-receipt.h"
+#include <stdbool.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+/* Receipt integrity/identity validator, not an authorization factory. Only use
+ * on receipt FDs received from the native sample object on the compositor's
+ * established Wayland connection, after a live authorized portal grant. */
+static inline bool apparent_clean_read_receipt_v1(int fd, uint32_t portal, uint64_t sequence,
+    uint64_t generation, uint32_t frame, uint32_t buffer, struct apparent_clean_receipt_v1 *r) {
+    struct stat st;
+    const int required=F_SEAL_WRITE|F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_SEAL;
+    const int seals=fcntl(fd,F_GET_SEALS);
+    return r && seals>=0 && (seals&required)==required && fstat(fd,&st)==0 && st.st_size==sizeof(*r) &&
+        pread(fd,r,sizeof(*r),0)==sizeof(*r) && r->magic==APPARENT_CLEAN_MAGIC && r->version==1 && r->size==sizeof(*r) &&
+        r->portal==portal && r->sequence==sequence && r->buffer_generation==generation && r->frame_id==frame && r->buffer_id==buffer &&
+        r->source_generation && r->role_serial && r->surface_id && r->width>0 && r->height>0 &&
+        r->output_width>0 && r->output_height>0 && r->scale==1.0 && r->transform==0 && r->cursor<=1;
+}
