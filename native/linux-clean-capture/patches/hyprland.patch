+    ~Peer() { sd_bus_slot_unref(backendWatch); sd_bus_unref(backendBus); if (fd >= 0) close(fd); }
+    Peer(const Peer&) = delete;
+    static std::shared_ptr<Peer> pin(wl_client* c) {
