+#pragma once
+#include <systemd/sd-bus.h>
+#include <sys/socket.h>
+#include <poll.h>
+#include <unistd.h>
+#include <wayland-server-core.h>
+#include <memory>
+#include <string>
+#include <string_view>
+
+namespace Apparent::Clean {
+// SO_PEERPIDFD pins the process that opened the Wayland socket. No pidfd_open
+// on a cached numeric PID, no /proc executable guess, no same-UID admission.
+class Peer {
+    int fd = -1;
+    mutable std::string backendOwner;
+    mutable bool backendRevoked = false;
+    mutable sd_bus* backendBus = nullptr;
