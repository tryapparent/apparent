+#pragma once
+#include <stdint.h>
+/* Private v1 wire ABI; little-endian Linux x86_64 only. No timestamps or raw
+ * pointers are authority. Copy this record unchanged with its associated pixels. */
+#define APPARENT_CLEAN_META_TYPE 0x10001u
+#define APPARENT_CLEAN_MAGIC 0x314e4c43u
+struct apparent_clean_receipt_v1 {
+    uint32_t magic, version, size, portal;
+    uint64_t sequence, source_generation, buffer_generation;
+    uint32_t frame_id, buffer_id, role_serial, surface_id;
+    int32_t x, y, width, height;
+    int32_t output_width, output_height;
+    uint32_t transform, cursor;
+    double scale;
+};
