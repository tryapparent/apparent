+bool CScreencopyProtocol::attachCleanFrame(wl_client* requester, wl_resource* resource, SP<Screenshare::CCleanFrameContext> context) {
+    if (!requester || !resource || !context || !context->matchesNativeFrame(resource) || wl_resource_get_client(resource) != requester)
+        return false;
+    for (const auto& frame : m_frames) {
+        if (frame->m_resource->resource() != resource || frame->m_resource->client() != requester)
+            continue;
+        // Attach once, before copy(), to the existing selected frame only.
+        // No new managed session or output selector is introduced here.
+        return !frame->m_buffer && frame->m_frame && frame->m_frame->attachCleanContext(context);
+    }
+    return false;
+}
