+// Source-integrated R8 offscreen scene render. No plugin, hook or HyprCtl IPC.
+#include "Renderer.hpp"
+#include "../Compositor.hpp"
+#include "../config/ConfigValue.hpp"
+#include "../state/MonitorState.hpp"
+#include "../desktop/state/FocusState.hpp"
+#include "../notification/NotificationOverlay.hpp"
+#include "../errorOverlay/Overlay.hpp"
+#include <GLES3/gl32.h>
+
+using namespace Render;
+
+SP<IFramebuffer> IHyprRenderer::renderCleanMonitor(PHLMONITOR monitor, PHLWINDOW excluded) {
+    // These are the R8 renderer's still-unproved cases, not a product contract.
+    // Never certify an untested transform/effect as clean.
+    if (m_cleanRendering || m_renderData.pMonitor || m_bRenderingSnapshot || type() != RT_GL ||
+        !monitor || !excluded || !excluded->m_isMapped || !monitor->m_output || !monitor->m_activeWorkspace ||
+        !monitor->m_dpmsStatus || monitor->isMirror() || monitor->m_isBeingLeased ||
+        g_pSessionLockManager->isSessionLocked() || !g_pCompositor->m_sessionActive || !g_pCompositor->m_dpmsStateOn ||
+        monitor->m_scale != 1.0 || monitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL || monitor->m_enabled10bit || monitor->m_cmType != NCMType::CM_SRGB ||
+        monitor->m_cursorZoom->value() != 1.F || m_crashingInProgress || !Desktop::fadingOutState()->fadeouts().empty()) return {};
+    static auto debugOverlay = CConfigValue<Config::INTEGER>("debug:overlay");
+    static auto damageBlink = CConfigValue<Config::INTEGER>("debug:damage_blink");
+    static auto screenShader = CConfigValue<std::string>("decoration:screen_shader");
+    if (*debugOverlay || *damageBlink || (!(*screenShader).empty() && *screenShader != STRVAL_EMPTY) || monitor->m_dpmsBlackOpacity->value() != 0.F) return {};
+    const auto size = monitor->m_pixelSize;
+    if (size.x < 1 || size.y < 1 || size.x > 8192 || size.y > 8192) return {};
+    auto fb = createFB("Apparent per-frame clean monitor source");
+    if (!fb || !fb->alloc(size.x, size.y, DRM_FORMAT_ABGR8888)) return {};
+    fb->setImageDescription(NColorManagement::DEFAULT_SRGB_IMAGE_DESCRIPTION);
+    GLint savedDraw = 0, read = 0, viewport[4]{};
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &savedDraw);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    const auto savedData = m_renderData;
+    const bool savedFeedback = m_bBlockSurfaceFeedback;
+    const auto savedMode = m_renderMode;
+    CRenderPass savedPass;
+    std::swap(savedPass, m_renderPass);
+    CScopeGuard restore([&] {
+        m_cleanRendering = false; m_cleanExcluded.reset();
+        m_bBlockSurfaceFeedback = savedFeedback; m_renderData = savedData; m_renderMode = savedMode;
+        std::swap(savedPass, m_renderPass);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, savedDraw); glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+        glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    });
+    CRegion damage{0, 0, size.x, size.y};
+    if (!beginFullFakeRender(monitor, damage, fb)) return {};
+    m_bBlockSurfaceFeedback = true;
+    m_cleanRendering = true; m_cleanExcluded = excluded;
+    draw(CClearPassElement::SClearData{CHyprColor(0, 0, 0, 1)});
+    startRenderPass();
+    const auto now = Time::steadyNow();
+    CBox box{{}, size};
+    // Read the current scene on the originally selected monitor. This is not
+    // a Workspace source: pinned/special/floating/layer content stays in scene.
+    renderWorkspace(monitor, monitor->m_activeWorkspace, now, box);
+    renderIME(monitor, now, box);
+    if (monitor == Desktop::focusState()->monitor()) {
+        Notification::overlay()->draw(monitor); ErrorOverlay::overlay()->draw();
+    }
+    // No cursor here. The existing capture path adds it after protection masks.
+    endRender();
+    return fb;
+}
